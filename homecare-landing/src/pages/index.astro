---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Home Care Growth — Scale Your Home Care Agency">
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          Trusted by 200+ Home Care Agencies
        </div>
        <h1 class="hero-title">
          Grow Your Home Care Agency <span class="highlight">Faster Than Ever</span>
        </h1>
        <p class="hero-subtitle">
          We help home care agencies attract more private-pay clients, build referral networks, and scale revenue — without wasting budget on marketing that doesn't work.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.67A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            Get Free Strategy Call
          </a>
          <a href="#results" class="btn-ghost">
            See Our Results
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="hero-trust">
          <div class="trust-avatars">
            <div class="avatar" style="background:#6366f1"></div>
            <div class="avatar" style="background:#f59e0b"></div>
            <div class="avatar" style="background:#10b981"></div>
            <div class="avatar" style="background:#ef4444"></div>
          </div>
          <p class="trust-text">
            <strong>4.9/5 rating</strong> from agency owners across the US
          </p>
        </div>
      </div>

      <div class="hero-visual">
        <div class="dashboard-card">
          <div class="dash-header">
            <div class="dash-title">Agency Growth Dashboard</div>
            <div class="dash-badge live">● Live</div>
          </div>
          <div class="dash-stats">
            <div class="dash-stat">
              <div class="dash-stat-value">+127%</div>
              <div class="dash-stat-label">Client Growth</div>
              <div class="dash-trend up">↑ This Quarter</div>
            </div>
            <div class="dash-stat">
              <div class="dash-stat-value">$48K</div>
              <div class="dash-stat-label">Monthly Revenue</div>
              <div class="dash-trend up">↑ +$12K MoM</div>
            </div>
          </div>
          <div class="dash-chart">
            <div class="chart-bar" style="height:40%"></div>
            <div class="chart-bar" style="height:55%"></div>
            <div class="chart-bar" style="height:45%"></div>
            <div class="chart-bar" style="height:70%"></div>
            <div class="chart-bar" style="height:60%"></div>
            <div class="chart-bar" style="height:85%"></div>
            <div class="chart-bar active" style="height:100%"></div>
          </div>
          <div class="dash-footer">
            <div class="referral-item">
              <div class="ref-dot" style="background:#1a6b4a"></div>
              <span>New referrals: <strong>24 this week</strong></span>
            </div>
            <div class="referral-item">
              <div class="ref-dot" style="background:#f59e0b"></div>
              <span>Inquiries: <strong>18 pending</strong></span>
            </div>
          </div>
        </div>

        <div class="floating-card card-1">
          <div class="fc-icon">🏆</div>
          <div>
            <div class="fc-title">Top Agency Award</div>
            <div class="fc-sub">Regional Leader 2024</div>
          </div>
        </div>

        <div class="floating-card card-2">
          <div class="fc-icon">📈</div>
          <div>
            <div class="fc-title">Revenue Up 340%</div>
            <div class="fc-sub">in 8 months</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LOGOS / TRUST BAR -->
  <section class="trust-bar">
    <div class="container">
      <p class="trust-bar-label">Trusted by agencies certified & partnered with</p>
      <div class="trust-logos">
        <div class="trust-logo">ACHC</div>
        <div class="trust-logo">The Joint Commission</div>
        <div class="trust-logo">HCAOA</div>
        <div class="trust-logo">Private Duty Alliance</div>
        <div class="trust-logo">Home Care Pulse</div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="problem-section">
    <div class="container">
      <div class="problem-inner">
        <div class="problem-content">
          <span class="section-label">Sound Familiar?</span>
          <h2 class="section-title">Most Home Care Agencies Are Leaving Money on the Table</h2>
          <p class="section-subtitle">You provide great care — but growth doesn't happen automatically.</p>
          <ul class="problem-list">
            <li>
              <div class="problem-icon">✗</div>
              <div>
                <strong>No consistent referral pipeline</strong>
                <p>Relying on word-of-mouth alone keeps revenue unpredictable and growth stalled.</p>
              </div>
            </li>
            <li>
              <div class="problem-icon">✗</div>
              <div>
                <strong>Wasting money on ads that don't convert</strong>
                <p>Generic marketing agencies don't understand home care — you pay for clicks, not clients.</p>
              </div>
            </li>
            <li>
              <div class="problem-icon">✗</div>
              <div>
                <strong>Can't compete with big franchise chains</strong>
                <p>Large brands dominate local search and referrals, leaving independent agencies struggling for visibility.</p>
              </div>
            </li>
            <li>
              <div class="problem-icon">✗</div>
              <div>
                <strong>No time to manage marketing yourself</strong>
                <p>You're focused on operations and care quality — not writing content or running campaigns.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="problem-visual">
          <div class="solution-preview">
            <div class="sp-header">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1a6b4a" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
              The Home Care Growth Solution
            </div>
            <div class="sp-items">
              <div class="sp-item">
                <div class="sp-check">✓</div>
                <span>Done-for-you referral partner outreach</span>
              </div>
              <div class="sp-item">
                <div class="sp-check">✓</div>
                <span>Hyper-local SEO that dominates your market</span>
              </div>
              <div class="sp-item">
                <div class="sp-check">✓</div>
                <span>High-converting Google & Facebook ads</span>
              </div>
              <div class="sp-item">
                <div class="sp-check">✓</div>
                <span>Automated lead follow-up system</span>
              </div>
              <div class="sp-item">
                <div class="sp-check">✓</div>
                <span>Monthly reporting & strategy calls</span>
              </div>
              <div class="sp-item">
                <div class="sp-check">✓</div>
                <span>Home care industry specialists only</span>
              </div>
            </div>
            <a href="#contact" class="btn-primary" style="width:100%;justify-content:center;margin-top:8px;">Let's Fix This →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services" id="services">
    <div class="container">
      <div class="section-header">
        <span class="section-label">What We Do</span>
        <h2 class="section-title">Everything You Need to Scale Your Agency</h2>
        <p class="section-subtitle">Specialized growth strategies built exclusively for home care agencies — private pay, Medicaid, and VA clients.</p>
      </div>

      <div class="services-grid">
        <div class="service-card featured">
          <div class="service-icon">🎯</div>
          <h3>Referral Network Building</h3>
          <p>We systematically connect you with discharge planners, social workers, geriatric care managers, and physicians who send consistent referrals every month.</p>
          <ul class="service-features">
            <li>Hospital & rehab facility partnerships</li>
            <li>Physician practice outreach</li>
            <li>Senior living community connections</li>
          </ul>
          <div class="service-result">Avg. +18 new referral sources/quarter</div>
        </div>

        <div class="service-card">
          <div class="service-icon">🔍</div>
          <h3>Local SEO Domination</h3>
          <p>Rank #1 in your city for "home care," "in-home care," and elder care searches. Families in need will find you first.</p>
          <ul class="service-features">
            <li>Google Business Profile optimization</li>
            <li>Local citation building</li>
            <li>Review generation strategy</li>
          </ul>
          <div class="service-result">Avg. 3x increase in organic leads</div>
        </div>

        <div class="service-card">
          <div class="service-icon">📱</div>
          <h3>Digital Advertising</h3>
          <p>Targeted Google and Facebook campaigns that reach adult children searching for care options for aging parents — at the exact moment they need you.</p>
          <ul class="service-features">
            <li>Google Search & Display ads</li>
            <li>Facebook & Instagram campaigns</li>
            <li>Retargeting & lookalike audiences</li>
          </ul>
          <div class="service-result">Avg. $18 cost per qualified lead</div>
        </div>

        <div class="service-card">
          <div class="service-icon">⚡</div>
          <h3>Lead Nurture & CRM</h3>
          <p>Never lose a lead again. Our automated follow-up system contacts inquiries within 5 minutes and nurtures them until they're ready to start care.</p>
          <ul class="service-features">
            <li>Instant lead response automation</li>
            <li>SMS + email nurture sequences</li>
            <li>CRM setup & management</li>
          </ul>
          <div class="service-result">Avg. 67% lead-to-consult rate</div>
        </div>

        <div class="service-card">
          <div class="service-icon">🌐</div>
          <h3>Website That Converts</h3>
          <p>Your website should be your top sales rep. We build or optimize your site to turn visitors into calls and consultations — 24/7.</p>
          <ul class="service-features">
            <li>Conversion-optimized design</li>
            <li>Mobile-first development</li>
            <li>A/B testing & optimization</li>
          </ul>
          <div class="service-result">Avg. 4.2x conversion improvement</div>
        </div>

        <div class="service-card">
          <div class="service-icon">📊</div>
          <h3>Analytics & Strategy</h3>
          <p>Complete visibility into what's working. Monthly strategy calls, clear ROI reporting, and ongoing optimization so your growth compounds over time.</p>
          <ul class="service-features">
            <li>Monthly performance reports</li>
            <li>Strategy calls with your specialist</li>
            <li>Competitor monitoring</li>
          </ul>
          <div class="service-result">Full ROI transparency, always</div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESULTS / STATS -->
  <section class="results" id="results">
    <div class="container">
      <div class="results-inner">
        <div class="results-content">
          <span class="section-label" style="background:rgba(255,255,255,0.15);color:#fff;">Proven Results</span>
          <h2 class="section-title" style="color:#fff;">Numbers That Speak for Themselves</h2>
          <p class="section-subtitle" style="color:rgba(255,255,255,0.8);">We've helped agencies across the country go from plateaued to scaling — with real, measurable results.</p>
          <a href="#contact" class="btn-secondary" style="margin-top:24px;">Start Getting Results →</a>
        </div>
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-number">200+</div>
            <div class="stat-label">Agencies Served</div>
            <div class="stat-desc">Across 35+ states</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">$2.4M</div>
            <div class="stat-label">Revenue Generated</div>
            <div class="stat-desc">For our clients last year</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">340%</div>
            <div class="stat-label">Avg. Revenue Growth</div>
            <div class="stat-desc">In first 12 months</div>
          </div>
          <div class="stat-card">
            <div class="stat-number">94%</div>
            <div class="stat-label">Client Retention</div>
            <div class="stat-desc">Stay with us long-term</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="process" id="process">
    <div class="container">
      <div class="section-header">
        <span class="section-label">How It Works</span>
        <h2 class="section-title">Your Path to a Thriving Agency</h2>
        <p class="section-subtitle">A simple, proven process designed specifically around how home care agencies grow.</p>
      </div>

      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">01</div>
          <div class="step-content">
            <h3>Free Strategy Call</h3>
            <p>We analyze your current client acquisition, revenue, service area, and competition. You'll get a custom growth roadmap — free, no strings attached.</p>
          </div>
        </div>

        <div class="process-connector"></div>

        <div class="process-step">
          <div class="step-number">02</div>
          <div class="step-content">
            <h3>Custom Growth Plan</h3>
            <p>We build a tailored strategy for your market, budget, and goals. No cookie-cutter packages — every plan is built around your specific situation.</p>
          </div>
        </div>

        <div class="process-connector"></div>

        <div class="process-step">
          <div class="step-number">03</div>
          <div class="step-content">
            <h3>Launch & Execute</h3>
            <p>We handle everything — campaigns, referral outreach, SEO, lead nurturing. You focus on delivering great care while we fill your pipeline.</p>
          </div>
        </div>

        <div class="process-connector"></div>

        <div class="process-step">
          <div class="step-number">04</div>
          <div class="step-content">
            <h3>Scale & Optimize</h3>
            <p>Monthly reviews, ongoing optimization, and scaling strategies as you grow. We grow with you — your success is our success.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials" id="testimonials">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Client Success Stories</span>
        <h2 class="section-title">Agency Owners Love Working With Us</h2>
        <p class="section-subtitle">Real results from real home care agencies — not made-up case studies.</p>
      </div>

      <div class="testimonials-grid">
        <div class="testimonial-card featured-testimonial">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote>
            "Before Home Care Growth, we were stuck at 12 clients for two years. Within 6 months of working with them, we had 34 active clients and had to hire 8 new caregivers. Their referral strategy alone was worth every penny. I only wish I'd found them sooner."
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar" style="background:#6366f1">MR</div>
            <div>
              <div class="author-name">Maria Rodriguez</div>
              <div class="author-title">Owner, Sunshine Home Care — Dallas, TX</div>
            </div>
            <div class="testimonial-metric">+183% clients</div>
          </div>
        </div>

        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote>
            "We went from $28K/month to $94K/month in 9 months. The team understood home care from day one — they're not generalists, they're specialists. Our Google rankings went from page 4 to #1 in our city."
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar" style="background:#10b981">JK</div>
            <div>
              <div class="author-name">James Kim</div>
              <div class="author-title">CEO, Premier Care Solutions — Atlanta, GA</div>
            </div>
            <div class="testimonial-metric">+236% revenue</div>
          </div>
        </div>

        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote>
            "I was skeptical of marketing agencies after two bad experiences. These guys are different. They showed me exactly where every dollar went and what it produced. Best ROI I've ever had in my business."
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar" style="background:#f59e0b">ST</div>
            <div>
              <div class="author-name">Sandra Thompson</div>
              <div class="author-title">Owner, Guardian Angel Care — Phoenix, AZ</div>
            </div>
            <div class="testimonial-metric">12x ROI</div>
          </div>
        </div>

        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote>
            "The referral network they built us is incredible. We now have 12 hospitals and 8 rehab facilities sending us consistent referrals every month. Our private-pay census tripled in under a year."
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar" style="background:#ef4444">DL</div>
            <div>
              <div class="author-name">David Lee</div>
              <div class="author-title">Owner, Caring Hands Agency — Chicago, IL</div>
            </div>
            <div class="testimonial-metric">3x private-pay</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="section-label">FAQ</span>
        <h2 class="section-title">Common Questions</h2>
        <p class="section-subtitle">Everything you need to know before getting started.</p>
      </div>

      <div class="faq-grid">
        <div class="faq-item">
          <h3>Do you work with small agencies just starting out?</h3>
          <p>Yes. We work with agencies at all stages — from startups with 2–3 clients to established agencies doing $500K+/year. Your strategy will be tailored to your stage and goals.</p>
        </div>
        <div class="faq-item">
          <h3>How long until I see results?</h3>
          <p>Most clients see initial results (new leads, referral conversations) within 30–60 days. Significant revenue growth typically happens between months 3–6. SEO results build over 6–12 months.</p>
        </div>
        <div class="faq-item">
          <h3>What does it cost?</h3>
          <p>Programs start at $1,500/month depending on your market and services needed. We'll give you a specific quote on your strategy call. No hidden fees, no long-term contracts required.</p>
        </div>
        <div class="faq-item">
          <h3>Do you specialize in private pay, Medicaid, or both?</h3>
          <p>We specialize in private pay and VA clients but have experience with Medicaid-funded programs as well. We'll tailor the strategy to your payer mix and goals.</p>
        </div>
        <div class="faq-item">
          <h3>Will you work with my competitors in my area?</h3>
          <p>No. We offer market exclusivity — once you're a client, we won't work with a competing agency in your primary service area. Your market stays yours.</p>
        </div>
        <div class="faq-item">
          <h3>Do I need to sign a long-term contract?</h3>
          <p>We use 3-month starter agreements to give campaigns time to deliver results, then move to month-to-month. We don't trap clients — we earn your business every month.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA / CONTACT -->
  <section class="contact" id="contact">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-content">
          <span class="section-label" style="background:rgba(255,255,255,0.15);color:#fff;">Get Started Today</span>
          <h2 class="section-title" style="color:#fff;">Ready to Finally Grow Your Agency?</h2>
          <p class="section-subtitle" style="color:rgba(255,255,255,0.85);">
            Book a free 30-minute strategy call. We'll review your agency, your market, and build a custom growth roadmap — no pressure, no pitch, just strategy.
          </p>
          <div class="contact-benefits">
            <div class="cb-item">
              <span class="cb-icon">✓</span>
              Free custom growth roadmap
            </div>
            <div class="cb-item">
              <span class="cb-icon">✓</span>
              Market & competitor analysis
            </div>
            <div class="cb-item">
              <span class="cb-icon">✓</span>
              No obligation, no pressure
            </div>
            <div class="cb-item">
              <span class="cb-icon">✓</span>
              Exclusive territory available
            </div>
          </div>
        </div>

        <div class="contact-form-wrap">
          <div class="form-card">
            <h3>Book Your Free Strategy Call</h3>
            <p>Fill out the form and we'll reach out within one business day to schedule your call.</p>
            <form class="contact-form" id="contactForm">
              <div class="form-row">
                <div class="form-group">
                  <label for="firstName">First Name</label>
                  <input type="text" id="firstName" name="firstName" placeholder="Jane" required />
                </div>
                <div class="form-group">
                  <label for="lastName">Last Name</label>
                  <input type="text" id="lastName" name="lastName" placeholder="Smith" required />
                </div>
              </div>
              <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="jane@youragency.com" required />
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="(555) 000-0000" required />
              </div>
              <div class="form-group">
                <label for="agencyName">Agency Name</label>
                <input type="text" id="agencyName" name="agencyName" placeholder="Your Agency Name" required />
              </div>
              <div class="form-group">
                <label for="revenue">Current Monthly Revenue</label>
                <select id="revenue" name="revenue" required>
                  <option value="">Select range...</option>
                  <option>Under $10K/month</option>
                  <option>$10K – $30K/month</option>
                  <option>$30K – $75K/month</option>
                  <option>$75K – $150K/month</option>
                  <option>$150K+/month</option>
                </select>
              </div>
              <button type="submit" class="btn-primary form-submit">
                Schedule My Free Strategy Call
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
              <p class="form-disclaimer">100% free. No spam. Unsubscribe anytime.</p>
            </form>
            <div class="form-success" id="formSuccess" style="display:none;">
              <div class="success-icon">🎉</div>
              <h4>You're all set!</h4>
              <p>We'll reach out within one business day to schedule your strategy call. Check your email for a confirmation.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">
            <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
              <rect width="32" height="32" rx="8" fill="#1a6b4a"/>
              <path d="M16 6C16 6 8 11 8 18C8 22.4183 11.5817 26 16 26C20.4183 26 24 22.4183 24 18C24 11 16 6 16 6Z" fill="white" opacity="0.9"/>
              <path d="M16 12C16 12 11 15 11 19C11 21.7614 13.2386 24 16 24C18.7614 24 21 21.7614 21 19C21 15 16 12 16 12Z" fill="#1a6b4a"/>
              <path d="M16 17C16 17 13.5 18.5 13.5 20.5C13.5 21.8807 14.6193 23 16 23C17.3807 23 18.5 21.8807 18.5 20.5C18.5 18.5 16 17 16 17Z" fill="white"/>
            </svg>
            <span>Home Care <strong>Growth</strong></span>
          </div>
          <p>Helping home care agencies grow their client base, revenue, and impact — across America.</p>
          <div class="footer-social">
            <a href="#" aria-label="Facebook">
