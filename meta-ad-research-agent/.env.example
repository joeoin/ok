# ---------------------------------------------------------------------------
# LLM configuration
# ---------------------------------------------------------------------------
# Provider: "openai" (any OpenAI-compatible API, incl. local models), "anthropic",
# or "none" (skip AI analysis entirely — scrape + export only).
LLM_PROVIDER=openai

# API key for the chosen provider. Not required for LLM_PROVIDER=none or for
# local OpenAI-compatible servers that don't check keys.
LLM_API_KEY=

# Base URL. Defaults:
#   openai    -> https://api.openai.com/v1
#   anthropic -> https://api.anthropic.com
# For local models point at your server, e.g. http://localhost:11434/v1 (Ollama).
LLM_BASE_URL=

# Model name, e.g. gpt-4o-mini, claude-sonnet-5, llama3.1:8b
LLM_MODEL=gpt-4o-mini

# Max concurrent LLM calls during per-ad analysis.
LLM_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Scraper configuration
# ---------------------------------------------------------------------------
# Run the browser headless (true/false). Set false to watch it work.
HEADLESS=true

# Optional: path to a Chromium binary to use instead of Playwright's managed
# download (useful in sandboxes/CI with a pre-installed browser).
CHROMIUM_PATH=

# Country filter for the Ad Library search. "ALL" or an ISO code like US, GB, DE.
AD_LIBRARY_COUNTRY=ALL

# Maximum number of ads to collect and analyze. 0 = unlimited.
MAX_ADS=100

# Navigation / network timeouts in milliseconds.
TIMEOUT_MS=30000

# How long to keep scrolling with no new ads before deciding we're done (ms).
SCROLL_IDLE_MS=8000

# ---------------------------------------------------------------------------
# Output configuration
# ---------------------------------------------------------------------------
# Root directory for all generated output. Subfolders per advertiser are created.
OUTPUT_DIR=.

# Capture per-ad element screenshots (true/false).
SCREENSHOTS=true

# Download ad creative images when a public URL is available (true/false).
DOWNLOAD_IMAGES=true

# Log level: debug | info | warn | error
LOG_LEVEL=info
