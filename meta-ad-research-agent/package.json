{
  "name": "meta-ad-research-agent",
  "version": "0.1.0",
  "description": "AI-powered competitor ad research agent for the Meta Ad Library (public data only)",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "research": "tsx src/index.ts",
    "web": "tsx src/server/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.49.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
